{
  "name": "pathai-career-trial",
  "version": "0.1.0",
  "private": true,
  "description": "PathAI 职业试岗舱微信小程序比赛 MVP",
  "packageManager": "npm@11.12.1",
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "db:validate": "node scripts/validate-database.mjs",
    "test": "node --test tests/*.test.mjs",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "metrics:summarize": "node scripts/summarize-metrics.mjs",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check": "npm run db:validate && npm test && npm run typecheck && npm run lint && npm run format:check"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.0",
    "eslint": "^10.0.0",
    "globals": "^16.5.0",
    "miniprogram-api-typings": "^4.0.2",
    "prettier": "^3.6.2",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.46.2"
  }
}
