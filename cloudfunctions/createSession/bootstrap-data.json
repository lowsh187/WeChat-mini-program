  "baseQuestions": [
    {
      "questionId": "base_information_01",
      "questionType": "base",
      "order": 1,
      "prompt": "面对一页包含多条信息的材料时，你通常先做什么？",
      "targetDimensions": ["information_extraction"],
      "options": [
        {
          "optionId": "a",
          "label": "先标记目标、事实和限制",
          "capabilityScores": {
            "information_extraction": 5
          }
        },
        {
          "optionId": "b",
          "label": "先从头读完再凭印象总结",
          "capabilityScores": {
            "information_extraction": 3
          }
        },
        {
          "optionId": "c",
          "label": "先找别人给出的结论",
          "capabilityScores": {
            "information_extraction": 1
          }
        }
      ],
      "status": "active",
      "configVersion": "1.0.0"
    },
    {
      "questionId": "base_logic_01",
      "questionType": "base",
      "order": 2,
      "prompt": "两个指标同时下降时，你更可能如何判断原因？",
      "targetDimensions": ["logical_analysis"],
      "options": [
        {
          "optionId": "a",
          "label": "列出多个假设并寻找区分它们的证据",
          "capabilityScores": {
            "logical_analysis": 5
          }
        },
        {
          "optionId": "b",
          "label": "选择最直观的原因继续推进",
          "capabilityScores": {
            "logical_analysis": 3
          }
        },
        {
          "optionId": "c",
          "label": "等待更多人给出判断",
          "capabilityScores": {
            "logical_analysis": 1
          }
        }
      ],
      "status": "active",
      "configVersion": "1.0.0"
    },
    {
      "questionId": "base_user_01",
      "questionType": "base",
      "order": 3,
      "prompt": "用户说“这个功能不好用”时，你最想先确认什么？",
      "targetDimensions": ["user_insight"],
      "options": [
        {
          "optionId": "a",
          "label": "具体场景、目标和受阻步骤",
          "capabilityScores": {
            "user_insight": 5
          }
        },
        {
          "optionId": "b",
          "label": "用户是否喜欢界面样式",
          "capabilityScores": {
            "user_insight": 3
          }
        },
        {
          "optionId": "c",
          "label": "用户是不是操作错误",
          "capabilityScores": {
            "user_insight": 1
          }
        }
      ],
      "status": "active",
      "configVersion": "1.0.0"
    },
    {
      "questionId": "base_communication_01",
      "questionType": "base",
      "order": 4,
      "prompt": "向团队同步复杂问题时，你更倾向于怎样表达？",
      "targetDimensions": ["communication"],
      "options": [
        {
          "optionId": "a",
          "label": "先给结论，再给证据和下一步",
          "capabilityScores": {
            "communication": 5
          }
        },
        {
          "optionId": "b",
          "label": "按发现过程逐步叙述",
          "capabilityScores": {
            "communication": 3
          }
        },
        {
          "optionId": "c",
          "label": "转发全部材料让大家自行判断",
          "capabilityScores": {
            "communication": 1
          }
        }
      ],
      "status": "active",
      "configVersion": "1.0.0"
    },
    {
      "questionId": "base_execution_01",
      "questionType": "base",
      "order": 5,
      "prompt": "收到一个目标模糊且时间有限的任务时，你通常先做什么？",
      "targetDimensions": ["execution_planning"],
      "options": [
        {
          "optionId": "a",
          "label": "确认交付标准并拆出优先步骤",
          "capabilityScores": {
            "execution_planning": 5
          }
        },
        {
          "optionId": "b",
          "label": "从自己最熟悉的部分开始",
          "capabilityScores": {
            "execution_planning": 3
          }
        },
        {
          "optionId": "c",
          "label": "等目标完全明确后再开始",
          "capabilityScores": {
            "execution_planning": 1
          }
        }
      ],
      "status": "active",
      "configVersion": "1.0.0"
    },
    {
      "questionId": "base_creative_01",
      "questionType": "base",
      "order": 6,
      "prompt": "需要为同一目标提出方案时，你通常如何开始？",
      "targetDimensions": ["creative_ideation"],
      "options": [
        {
          "optionId": "a",
          "label": "先提出多个差异明显的方向再筛选",
          "capabilityScores": {
            "creative_ideation": 5
          }
        },
        {
          "optionId": "b",
          "label": "优化已有且最稳妥的方案",
          "capabilityScores": {
            "creative_ideation": 3
          }
        },
        {
          "optionId": "c",
          "label": "寻找一个模板直接套用",
          "capabilityScores": {
            "creative_ideation": 1
          }
        }
      ],
      "status": "active",
      "configVersion": "1.0.0"
    },
    {
      "questionId": "base_tradeoff_01",
      "questionType": "base",
      "order": 7,
      "prompt": "资源只够完成三个需求中的一个时，你会怎么做？",
      "targetDimensions": ["logical_analysis", "execution_planning"],
      "options": [
        {
          "optionId": "a",
          "label": "按用户价值、成本和风险排序并说明取舍",
          "capabilityScores": {
            "logical_analysis": 5,
            "execution_planning": 5
          }
        },
        {
          "optionId": "b",
          "label": "优先选择最快完成的需求",
          "capabilityScores": {
            "logical_analysis": 3,
            "execution_planning": 3
          }
        },
        {
          "optionId": "c",
          "label": "由提出需求的人决定",
          "capabilityScores": {
            "logical_analysis": 1,
            "execution_planning": 1
          }
        }
      ],
      "status": "active",
      "configVersion": "1.0.0"
    },
    {
      "questionId": "base_evidence_01",
      "questionType": "base",
      "order": 8,
      "prompt": "当自己的判断受到质疑时，你更可能怎样回应？",
      "targetDimensions": ["communication", "information_extraction"],
      "options": [
        {
          "optionId": "a",
          "label": "区分事实和假设，并说明还需验证什么",
          "capabilityScores": {
            "communication": 5,
            "information_extraction": 5
          }
        },
        {
          "optionId": "b",
          "label": "补充更多细节解释原判断",
          "capabilityScores": {
            "communication": 3,
            "information_extraction": 3
          }
        },
        {
          "optionId": "c",
          "label": "改用多数人的意见",
          "capabilityScores": {
            "communication": 1,
            "information_extraction": 1
          }
        }
      ],
      "status": "active",
      "configVersion": "1.0.0"
    }
  ],
