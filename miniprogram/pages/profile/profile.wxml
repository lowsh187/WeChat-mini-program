<view class="page">
  <view class="eyebrow">01 / 基础画像</view>
  <view class="title">从真实的选择开始</view>
  <view class="notice">题目与偏好选项是内容草案，仅验收交互。本阶段不计算画像分数，也不生成 AI 评价。</view>
  <block wx:if="{{!ready}}">
    <view class="card"><view class="muted">{{warning}}</view><button class="primary" bindtap="start">开始新的本地体验</button></view>
  </block>
  <block wx:else>
    <view class="card">
      <view class="card-title">你的探索起点</view>
      <view class="label">当前状态</view>
      <view class="choices"><button wx:for="{{currentStates}}" wx:key="id" class="chip {{profile.currentState === item.id ? 'chosen' : ''}}" data-field="currentState" data-value="{{item.id}}" bindtap="chooseProfile">{{item.label}}</button></view>
      <view class="label">这次想获得什么？</view>
      <view class="choices"><button wx:for="{{goals}}" wx:key="id" class="chip {{profile.goal === item.id ? 'chosen' : ''}}" data-field="goal" data-value="{{item.id}}" bindtap="chooseProfile">{{item.label}}</button></view>
      <view class="label">你更愿意如何开始？</view>
      <view class="choices"><button wx:for="{{preferences}}" wx:key="id" class="chip {{profile.preference === item.id ? 'chosen' : ''}}" data-field="preference" data-value="{{item.id}}" bindtap="chooseProfile">{{item.label}}</button></view>
    </view>
    <view class="section-title">情境题 {{questionIndex + 1}} / {{total}}</view>
    <progress percent="{{progressPercent}}" activeColor="#276b5b" backgroundColor="#e1e7dc" stroke-width="5" />
    <view class="muted progress-label">已回答 {{answeredCount}} 题 · 自动保存到本地设备</view>
    <view class="card">
      <view class="muted">{{question.context}}</view>
      <view class="question-title">{{question.title}}</view>
      <button wx:for="{{question.options}}" wx:key="id" class="option {{selectedOption === item.id ? 'chosen' : ''}}" data-option="{{item.id}}" bindtap="chooseAnswer">{{selectedOption === item.id ? '●' : '○'}}　{{item.label}}</button>
      <view class="step-actions">
        <button class="secondary" disabled="{{questionIndex === 0}}" bindtap="previous">上一题</button>
        <button wx:if="{{questionIndex < total - 1}}" class="primary" bindtap="next">下一题</button>
      </view>
    </view>
    <view wx:if="{{validation}}" class="error">{{validation}}</view>
    <view wx:if="{{warning}}" class="error">{{warning}}<button class="secondary" bindtap="retrySave">重试保存</button></view>
    <view class="actions">
      <button class="primary" loading="{{submitting}}" disabled="{{submitting}}" bindtap="submit">完成画像 · 进入 Mock 追问</button>
      <view class="muted bypass-note">接下来最多两轮预设追问，答案仅保存在本设备。当前不调用 AI。</view>
    </view>
  </block>
</view>
