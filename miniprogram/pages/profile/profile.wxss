@import "../../styles/frontend.wxss";
.label {
  margin: 24rpx 0 10rpx;
  font-size: 25rpx;
  color: #61716c;
}
.choices {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
}
.chip {
  margin: 0;
  padding: 8rpx 20rpx;
  font-size: 24rpx;
  background: #f2f4ee;
  color: #53635b;
  line-height: 1.8;
}
.chosen {
  background: #e5f0e9;
  color: #1d6956;
  box-shadow: inset 0 0 0 2rpx #357567;
}
.question-title {
  font-size: 34rpx;
  line-height: 1.6;
  font-weight: 600;
  margin: 20rpx 0;
}
.option {
  text-align: left;
  padding: 22rpx;
  line-height: 1.7;
  background: #f4f6f0;
  white-space: normal;
}
.option.chosen {
  background: #e5f0e9;
}
.step-actions {
  display: flex;
  gap: 16rpx;
}
.step-actions button {
  flex: 1;
}
.progress-label {
  margin-top: 14rpx;
}
.bypass-note {
  margin-top: 20rpx;
}
