.page {
  min-height: 100vh;
  padding: 96rpx 48rpx 48rpx;
}

.hero {
  display: flex;
  flex-direction: column;
  gap: 28rpx;
  padding: 56rpx 40rpx;
  border-radius: 32rpx;
  background: #ffffff;
  box-shadow: 0 16rpx 48rpx rgba(24, 34, 48, 0.08);
}

.eyebrow {
  color: #5265d8;
  font-size: 26rpx;
  font-weight: 600;
}

.title {
  font-size: 52rpx;
  font-weight: 700;
  line-height: 1.2;
}

.subtitle {
  color: #556273;
  font-size: 30rpx;
  line-height: 1.7;
}

.primary {
  width: 100%;
  margin-top: 16rpx;
  border: 0;
  border-radius: 20rpx;
  background: #5265d8;
  color: #ffffff;
}

.notice {
  display: block;
  margin-top: 32rpx;
  color: #7a8699;
  font-size: 24rpx;
  text-align: center;
}
